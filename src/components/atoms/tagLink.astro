---
import { getTagPath } from '../../lib/url';

type Props = {
    tag: string;
};

const { tag } = Astro.props;
---

<a
    href={getTagPath(tag)}
    class="rounded-full border border-stone-300 px-3 py-1 text-sm text-stone-700 transition-colors hover:border-black hover:text-black"
>
    #{tag}
</a>
