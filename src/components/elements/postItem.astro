---
import { type CollectionEntry } from 'astro:content';
import { formatDate } from '../../lib/posts';
import TagLink from '../atoms/tagLink.astro';

type Props = {
    post: CollectionEntry<'posts'>;
    isLast: boolean;
};
const { post, isLast } = Astro.props;
const borderClass = isLast
    ? 'border-none'
    : 'border-b border-stone-200 dark:border-stone-700';
---

<article class={`pb-8 ${borderClass}`}>
    <h2 class="mb-2 text-2xl font-semibold">
        <a
            href={`/posts/${post.id}`}
            class="hover:text-black/60 dark:hover:text-white/60"
        >
            {post.data.title}
        </a>
    </h2>
    <p class="mb-4 text-black/40 dark:text-white/40">
        {formatDate(post.data.pubDate)}
    </p>
    <p class="text-black/60 dark:text-white/60">
        {post.data.description}
    </p>
    {
        post.data.tags.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                    <TagLink tag={tag} />
                ))}
            </div>
        )
    }
    <a href={`/posts/${post.id}`} class="link mt-4">
        <span class="relative">Read more &rarr;</span>
    </a>
</article>
