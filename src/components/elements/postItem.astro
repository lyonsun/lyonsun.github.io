---
import { type Post } from '../../types';
type Props = {
    post: Post;
    borderClass: string;
};
const { post, borderClass } = Astro.props;
---

<article class={`pb-8 ${borderClass}`}>
    <h2 class="mb-2 text-2xl font-semibold">
        <a href={post.url} class="hover:text-black/60">
            {post.frontmatter.title}
        </a>
    </h2>
    <p class="mb-4 text-black/40">
        {
            new Date(post.frontmatter.pubDate).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
            })
        }
    </p>
    <p>
        {post.frontmatter.description}
    </p>
    <a href={post.url} class="link mt-4">
        <span class="relative">Read more &rarr;</span>
    </a>
</article>
