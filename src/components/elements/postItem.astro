---
import { type CollectionEntry } from 'astro:content';
import TagLink from '../atoms/tagLink.astro';

type Props = {
    post: CollectionEntry<'posts'>;
    borderClass: string;
    'data-animate'?: string;
    'data-delay'?: string;
};
const { post, borderClass } = Astro.props;
---

<article
    class={`pb-8 ${borderClass}`}
    data-animate={Astro.props['data-animate']}
    data-delay={Astro.props['data-delay']}
>
    <h2 class="mb-2 text-2xl font-semibold">
        <a href={`/posts/${post.id}`} class="hover:text-black/60">
            {post.data.title}
        </a>
    </h2>
    <p class="mb-4 text-black/40">
        {
            post.data.pubDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
            })
        }
    </p>
    <p class="text-black/60">
        {post.data.description}
    </p>
    {
        post.data.tags.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                    <TagLink tag={tag} />
                ))}
            </div>
        )
    }
    <a href={`/posts/${post.id}`} class="link mt-4">
        <span class="relative">Read more &rarr;</span>
    </a>
</article>
